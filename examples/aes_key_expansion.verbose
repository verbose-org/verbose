    let b39 = band(bxor(b23, b35), 255)
    let b40 = band(bxor(b24, b36), 255)
    let b41 = band(bxor(b25, b37), 255)
    let b42 = band(bxor(b26, b38), 255)
    let b43 = band(bxor(b27, b39), 255)
    let b44 = band(bxor(b28, b40), 255)
    let b45 = band(bxor(b29, b41), 255)
    let b46 = band(bxor(b30, b42), 255)
    let b47 = band(bxor(b31, b43), 255)
    let b48 = band(bxor(bxor(b32, aes_sbox(Byte { b: b45 })), 4), 255)
    let b49 = band(bxor(b33, aes_sbox(Byte { b: b46 })), 255)
    let b50 = band(bxor(b34, aes_sbox(Byte { b: b47 })), 255)
    let b51 = band(bxor(b35, aes_sbox(Byte { b: b44 })), 255)
    let b52 = band(bxor(b36, b48), 255)
