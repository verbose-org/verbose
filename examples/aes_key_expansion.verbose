    let b130 = band(bxor(b114, aes_sbox(Byte { b: b127 })), 255)
    let b131 = band(bxor(b115, aes_sbox(Byte { b: b124 })), 255)
    let b132 = band(bxor(b116, b128), 255)
    let b133 = band(bxor(b117, b129), 255)
    let b134 = band(bxor(b118, b130), 255)
    let b135 = band(bxor(b119, b131), 255)
    let b136 = band(bxor(b120, b132), 255)
    let b137 = band(bxor(b121, b133), 255)
    let b138 = band(bxor(b122, b134), 255)
    let b139 = band(bxor(b123, b135), 255)
