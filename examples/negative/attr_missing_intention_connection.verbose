@verbose 0.1.0

-- NEGATIVE: the connection declares no @intention.

concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule gate
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = i.amount > 1000

  proofs:
    purity:
      reads   : [i.amount]
      calls   : []
    termination:
      bound : 1

connection upstream
  @source: negative.intent:3
  host: "127.0.0.1"
  port: 19000
  max_response: 1024
  on_connect_error: abort
