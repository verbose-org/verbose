@verbose 0.1.0

-- `helper` takes one argument and is called with two. BOTH compilers refuse
-- it as of 2026-08-13 — gen0 via `rule_diags` category 3 (`badarity_rule`),
-- verbosec via `check_call_arity` in src/verifier.rs.
--
-- WAS THE CORPUS'S ONLY INVERSE CASE from 2026-08-10 to 2026-08-13: verbosec
-- ACCEPTED this, printing "all proofs check out", while its own `--native`
-- and `--run` both refused it. Not a safety hole (it failed closed on both
-- execution paths) but a truthfulness hole in the component whose whole job
-- is to be trustworthy. Being asserted as an INVERSE, rather than filed in a
-- bucket, is what kept it visible until it was fixed.
concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule helper
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = i.amount > 1000

  proofs:
    purity:
      reads   : [i.amount]
      calls   : []
    termination:
      bound : 1


rule caller
  @intention: "doc"
  @source: negative.intent:3

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = helper(i, i)

  proofs:
    purity:
      reads   : [i]
      calls   : [helper]
    termination:
      bound : 3


