@verbose 0.1.0

-- NEGATIVE (control): `no_such_rule` is not declared.
concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule gate
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = no_such_rule(i)

  proofs:
    purity:
      reads   : [i]
      calls   : [no_such_rule]
    termination:
      bound : 3


