@verbose 0.1.0

-- NEGATIVE: `reads:` declares i.tier, which the logic never touches
-- (and which the concept does not even have).
concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule gate
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = i.amount > 1000

  proofs:
    purity:
      reads   : [i.amount, i.tier]
      calls   : []
    termination:
      bound : 1


