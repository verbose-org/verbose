@verbose 0.1.0

-- NEGATIVE: `overflow : [10, 0]` is an empty interval (min > max).
concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule doubled
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    total : number

  logic:
    total = i.amount * 2

  proofs:
    purity:
      reads   : [i.amount]
      calls   : []
    termination:
      bound : 1

  hints:
    overflow : [10, 0]


