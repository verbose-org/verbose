@verbose 0.1.0

-- NEGATIVE: `calls:` declares `helper`, which the logic never calls.
concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule helper
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = i.amount > 1000

  proofs:
    purity:
      reads   : [i.amount]
      calls   : []
    termination:
      bound : 1


rule caller
  @intention: "doc"
  @source: negative.intent:3

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = i.amount > 5000

  proofs:
    purity:
      reads   : [i.amount]
      calls   : [helper]
    termination:
      bound : 3


