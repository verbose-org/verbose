@verbose 0.1.0

-- NEGATIVE: `vectorizable` with no justification string. verbosec's parser
-- requires the justification; the bare keyword form is rejected.
concept Invoice
  @intention: "An invoice has an amount"
  @source: negative.intent:1

  fields:
    amount : number [0, 1000000]

rule gate
  @intention: "doc"
  @source: negative.intent:2

  input:
    i : Invoice

  output:
    ok : bool

  logic:
    ok = i.amount > 1000

  proofs:
    purity:
      reads   : [i.amount]
      calls   : []
    termination:
      bound : 1

  hints:
    vectorizable


