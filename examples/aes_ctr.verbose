-- The FIPS-197 forward S-box as a DECLARED CONSTANT TABLE.
--
-- The 256 bytes below are S[0], S[1], ... S[255] in order, so the whole rule
-- is one indexed read. This used to be 254 chained `else if` branches here,
-- as it was in `aes_sbox.verbose` before the table form existed -- read that
-- file for why the literal is the honest spelling and not a shortcut.
--
-- Two properties carry over unchanged. `b"..."` is the only place `\xNN` is
-- legal, so it is the only way to name S[82] = 0x00 at all; and `byte_at` is
-- bounds-checked fail-closed, so an index outside the table exits(1) rather
-- than reading past it. Every call site here passes either a field declared
-- `number [0, 255]` or a `band(..., 255)` result, so the index is in range by
-- construction and the read can never fail.
--
-- Correctness is not asserted by this comment. It is checked against an
-- S-box derived independently in GF(2^8) -- see
-- `aes_family_declared_sbox_tables_match_fips197_oracle` in src/native.rs.
rule aes_sbox
  @intention: "AES forward S-box (FIPS-197 Figure 7)"
  @source: aes_ctr.intent:2
  input:
    inp : Byte
  output:
    out : number
  logic:
    out = byte_at(b"\x63\x7c\x77\x7b\xf2\x6b\x6f\xc5\x30\x01\x67\x2b\xfe\xd7\xab\x76\xca\x82\xc9\x7d\xfa\x59\x47\xf0\xad\xd4\xa2\xaf\x9c\xa4\x72\xc0\xb7\xfd\x93\x26\x36\x3f\xf7\xcc\x34\xa5\xe5\xf1\x71\xd8\x31\x15\x04\xc7\x23\xc3\x18\x96\x05\x9a\x07\x12\x80\xe2\xeb\x27\xb2\x75\x09\x83\x2c\x1a\x1b\x6e\x5a\xa0\x52\x3b\xd6\xb3\x29\xe3\x2f\x84\x53\xd1\x00\xed\x20\xfc\xb1\x5b\x6a\xcb\xbe\x39\x4a\x4c\x58\xcf\xd0\xef\xaa\xfb\x43\x4d\x33\x85\x45\xf9\x02\x7f\x50\x3c\x9f\xa8\x51\xa3\x40\x8f\x92\x9d\x38\xf5\xbc\xb6\xda\x21\x10\xff\xf3\xd2\xcd\x0c\x13\xec\x5f\x97\x44\x17\xc4\xa7\x7e\x3d\x64\x5d\x19\x73\x60\x81\x4f\xdc\x22\x2a\x90\x88\x46\xee\xb8\x14\xde\x5e\x0b\xdb\xe0\x32\x3a\x0a\x49\x06\x24\x5c\xc2\xd3\xac\x62\x91\x95\xe4\x79\xe7\xc8\x37\x6d\x8d\xd5\x4e\xa9\x6c\x56\xf4\xea\x65\x7a\xae\x08\xba\x78\x25\x2e\x1c\xa6\xb4\xc6\xe8\xdd\x74\x1f\x4b\xbd\x8b\x8a\x70\x3e\xb5\x66\x48\x03\xf6\x0e\x61\x35\x57\xb9\x86\xc1\x1d\x9e\xe1\xf8\x98\x11\x69\xd9\x8e\x94\x9b\x1e\x87\xe9\xce\x55\x28\xdf\x8c\xa1\x89\x0d\xbf\xe6\x42\x68\x41\x99\x2d\x0f\xb0\x54\xbb\x16", inp.b)
  proofs:
    purity:
      reads : [inp.b]
      calls : []
    termination:
      bound : 1


rule xtime
  @intention: "GF(2^8) multiply by x"
  @source: aes_ctr.intent:3
  input:
    inp : Byte
  output:
    out : number
  logic:
    out = if band(inp.b, 128) > 0 then band(bxor(shl(inp.b, 1), 27), 255) else band(shl(inp.b, 1), 255)
  proofs:
    purity:
      reads : [inp.b]
      calls : []
    termination:
      bound : 20


rule ctr_block
  @intention: "AES-128-CTR one block: ciphertext = plaintext XOR AES-128(counter, key); returns byte `which`"
