@verbose 0.1.0

concept Byte
  @intention: "single byte 0..255"
  @source: aes_ctr.intent:1
  fields:
    b : number [0, 255]

concept CtrInput
  @intention: "16-byte plaintext block + 16-byte AES-128 key + 16-byte counter block + which output byte"
  @source: aes_ctr.intent:1
  fields:
