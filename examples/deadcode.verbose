@verbose 0.1.0

-- Range-analysis example: the first branch is unreachable on valid input.
-- Both branches must pass strict verification. Native lowering then removes
-- the impossible branch while retaining the temperature input guard.

concept Sensor
  @intention: "A sensor has a temperature value between 0 and 50 degrees"
  @source: deadcode.intent:1

  fields:
    temperature : number [0, 50]


rule alert_level
  @intention: "The alert level is: 2 if above 100 (impossible), 1 if above 40, otherwise 0"
  @source: deadcode.intent:2

  input:
    s : Sensor

  output:
    level : number

  logic:
    level = if s.temperature > 100 then 2 else if s.temperature > 40 then 1 else 0

  proofs:
    purity:
      reads   : [s.temperature]
      calls   : []
    termination:
      bound : 5

  hints:
    overflow : [0, 2]
