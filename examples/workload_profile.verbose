@verbose 0.1.0
use "sequential_stack.verbose"

execution inspect_usage
  @intention: "Describe likely reading batches and latency targets within a fixed native reservation"
  @source: workload_profile.intent:1
  input: Reading
  mode: concurrent
  phases: [clamp, nonnegative, label]
  on_failure: stop
  max_in_flight: 2
  result_batch: 32
  native_memory: 20480
  workload:
    objective: elapsed
    case interactive:
      weight: 99
      records: 1
      target_us: 2000
    case bulk:
      weight: 1
      records: 4096
      target_us: 100000
