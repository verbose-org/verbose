    b10 : number [0, 255]
    b11 : number [0, 255]
    b12 : number [0, 255]
    b13 : number [0, 255]
    b14 : number [0, 255]
    b15 : number [0, 255]
    k0 : number [0, 255]
    k1 : number [0, 255]
    k2 : number [0, 255]
    k3 : number [0, 255]
    k4 : number [0, 255]
    k5 : number [0, 255]
    k6 : number [0, 255]
    k7 : number [0, 255]
    k8 : number [0, 255]
