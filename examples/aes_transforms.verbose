    k10 : number [0, 255]
    k11 : number [0, 255]
    k12 : number [0, 255]
    k13 : number [0, 255]
    k14 : number [0, 255]
    k15 : number [0, 255]
    which : number [0, 15]


-- The FIPS-197 forward S-box as a DECLARED CONSTANT TABLE.
--
-- The 256 bytes below are S[0], S[1], ... S[255] in order, so the whole rule
-- is one indexed read. This used to be 254 chained `else if` branches here,
-- as it was in `aes_sbox.verbose` before the table form existed -- read that
-- file for why the literal is the honest spelling and not a shortcut.
--
-- Two properties carry over unchanged. `b"..."` is the only place `\xNN` is
-- legal, so it is the only way to name S[82] = 0x00 at all; and `byte_at` is
-- bounds-checked fail-closed, so an index outside the table exits(1) rather
-- than reading past it. Every call site here passes either a field declared
-- `number [0, 255]` or a `band(..., 255)` result, so the index is in range by
-- construction and the read can never fail.
--
-- Correctness is not asserted by this comment. It is checked against an
-- S-box derived independently in GF(2^8) -- see
-- `aes_family_declared_sbox_tables_match_fips197_oracle` in src/native.rs.
rule aes_sbox
  @intention: "AES forward S-box (FIPS-197 Figure 7)"
  @source: aes_transforms.intent:2
  input:
    inp : Byte
  output:
    out : number
  logic:
    out = byte_at(b"\x63\x7c\x77\x7b\xf2\x6b\x6f\xc5\x30\x01\x67\x2b\xfe\xd7\xab\x76\xca\x82\xc9\x7d\xfa\x59\x47\xf0\xad\xd4\xa2\xaf\x9c\xa4\x72\xc0\xb7\xfd\x93\x26\x36\x3f\xf7\xcc\x34\xa5\xe5\xf1\x71\xd8\x31\x15\x04\xc7\x23\xc3\x18\x96\x05\x9a\x07\x12\x80\xe2\xeb\x27\xb2\x75\x09\x83\x2c\x1a\x1b\x6e\x5a\xa0\x52\x3b\xd6\xb3\x29\xe3\x2f\x84\x53\xd1\x00\xed\x20\xfc\xb1\x5b\x6a\xcb\xbe\x39\x4a\x4c\x58\xcf\xd0\xef\xaa\xfb\x43\x4d\x33\x85\x45\xf9\x02\x7f\x50\x3c\x9f\xa8\x51\xa3\x40\x8f\x92\x9d\x38\xf5\xbc\xb6\xda\x21\x10\xff\xf3\xd2\xcd\x0c\x13\xec\x5f\x97\x44\x17\xc4\xa7\x7e\x3d\x64\x5d\x19\x73\x60\x81\x4f\xdc\x22\x2a\x90\x88\x46\xee\xb8\x14\xde\x5e\x0b\xdb\xe0\x32\x3a\x0a\x49\x06\x24\x5c\xc2\xd3\xac\x62\x91\x95\xe4\x79\xe7\xc8\x37\x6d\x8d\xd5\x4e\xa9\x6c\x56\xf4\xea\x65\x7a\xae\x08\xba\x78\x25\x2e\x1c\xa6\xb4\xc6\xe8\xdd\x74\x1f\x4b\xbd\x8b\x8a\x70\x3e\xb5\x66\x48\x03\xf6\x0e\x61\x35\x57\xb9\x86\xc1\x1d\x9e\xe1\xf8\x98\x11\x69\xd9\x8e\x94\x9b\x1e\x87\xe9\xce\x55\x28\xdf\x8c\xa1\x89\x0d\xbf\xe6\x42\x68\x41\x99\x2d\x0f\xb0\x54\xbb\x16", inp.b)
  proofs:
    purity:
      reads : [inp.b]
      calls : []
    termination:
      bound : 1


rule xtime
  @intention: "GF(2^8) multiply by x: shift-left then conditionally XOR with 0x1b"
  @source: aes_transforms.intent:3
  input:
    inp : Byte
  output:
    out : number
  logic:
    out = if band(inp.b, 128) > 0 then band(bxor(shl(inp.b, 1), 27), 255) else band(shl(inp.b, 1), 255)
  proofs:
    purity:
      reads : [inp.b]
      calls : []
    termination:
      bound : 20


rule sub_bytes
  @intention: "SubBytes — apply S-box to byte at index which"
  @source: aes_transforms.intent:4
  input:
    s : Block
  output:
    out : number
  logic:
    out = if s.which == 0 then aes_sbox(Byte { b: s.b0 })
      else if s.which == 1 then aes_sbox(Byte { b: s.b1 })
      else if s.which == 2 then aes_sbox(Byte { b: s.b2 })
      else if s.which == 3 then aes_sbox(Byte { b: s.b3 })
      else if s.which == 4 then aes_sbox(Byte { b: s.b4 })
      else if s.which == 5 then aes_sbox(Byte { b: s.b5 })
      else if s.which == 6 then aes_sbox(Byte { b: s.b6 })
      else if s.which == 7 then aes_sbox(Byte { b: s.b7 })
      else if s.which == 8 then aes_sbox(Byte { b: s.b8 })
      else if s.which == 9 then aes_sbox(Byte { b: s.b9 })
      else if s.which == 10 then aes_sbox(Byte { b: s.b10 })
      else if s.which == 11 then aes_sbox(Byte { b: s.b11 })
      else if s.which == 12 then aes_sbox(Byte { b: s.b12 })
      else if s.which == 13 then aes_sbox(Byte { b: s.b13 })
      else if s.which == 14 then aes_sbox(Byte { b: s.b14 })
      else aes_sbox(Byte { b: s.b15 })
  proofs:
    purity:
      reads : [s.b0, s.b1, s.b2, s.b3, s.b4, s.b5, s.b6, s.b7, s.b8, s.b9, s.b10, s.b11, s.b12, s.b13, s.b14, s.b15, s.which]
      calls : [aes_sbox]
    termination:
      bound : 100


rule shift_rows
  @intention: "ShiftRows — return the byte at the post-shift position which"
  @source: aes_transforms.intent:5
  input:
    s : Block
  output:
    out : number
  logic:
    out = if s.which == 0 then s.b0
      else if s.which == 1 then s.b5
      else if s.which == 2 then s.b10
      else if s.which == 3 then s.b15
      else if s.which == 4 then s.b4
      else if s.which == 5 then s.b9
      else if s.which == 6 then s.b14
      else if s.which == 7 then s.b3
      else if s.which == 8 then s.b8
      else if s.which == 9 then s.b13
      else if s.which == 10 then s.b2
      else if s.which == 11 then s.b7
      else if s.which == 12 then s.b12
      else if s.which == 13 then s.b1
      else if s.which == 14 then s.b6
      else s.b11
  proofs:
    purity:
      reads : [s.b0, s.b1, s.b2, s.b3, s.b4, s.b5, s.b6, s.b7, s.b8, s.b9, s.b10, s.b11, s.b12, s.b13, s.b14, s.b15, s.which]
      calls : []
    termination:
      bound : 100


rule mix_columns
  @intention: "MixColumns — column-by-column GF(2^8) matrix multiply"
  @source: aes_transforms.intent:6
  input:
    s : Block
  output:
    out : number
  logic:
    out = if s.which == 0 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b0 }), xtime(Byte { b: s.b1 })), s.b1), s.b2), s.b3), 255)
      else if s.which == 1 then band(bxor(bxor(bxor(bxor(s.b0, xtime(Byte { b: s.b1 })), xtime(Byte { b: s.b2 })), s.b2), s.b3), 255)
      else if s.which == 2 then band(bxor(bxor(bxor(bxor(s.b0, s.b1), xtime(Byte { b: s.b2 })), xtime(Byte { b: s.b3 })), s.b3), 255)
      else if s.which == 3 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b0 }), s.b0), s.b1), s.b2), xtime(Byte { b: s.b3 })), 255)
      else if s.which == 4 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b4 }), xtime(Byte { b: s.b5 })), s.b5), s.b6), s.b7), 255)
      else if s.which == 5 then band(bxor(bxor(bxor(bxor(s.b4, xtime(Byte { b: s.b5 })), xtime(Byte { b: s.b6 })), s.b6), s.b7), 255)
      else if s.which == 6 then band(bxor(bxor(bxor(bxor(s.b4, s.b5), xtime(Byte { b: s.b6 })), xtime(Byte { b: s.b7 })), s.b7), 255)
      else if s.which == 7 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b4 }), s.b4), s.b5), s.b6), xtime(Byte { b: s.b7 })), 255)
      else if s.which == 8 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b8 }), xtime(Byte { b: s.b9 })), s.b9), s.b10), s.b11), 255)
      else if s.which == 9 then band(bxor(bxor(bxor(bxor(s.b8, xtime(Byte { b: s.b9 })), xtime(Byte { b: s.b10 })), s.b10), s.b11), 255)
      else if s.which == 10 then band(bxor(bxor(bxor(bxor(s.b8, s.b9), xtime(Byte { b: s.b10 })), xtime(Byte { b: s.b11 })), s.b11), 255)
      else if s.which == 11 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b8 }), s.b8), s.b9), s.b10), xtime(Byte { b: s.b11 })), 255)
      else if s.which == 12 then band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b12 }), xtime(Byte { b: s.b13 })), s.b13), s.b14), s.b15), 255)
      else if s.which == 13 then band(bxor(bxor(bxor(bxor(s.b12, xtime(Byte { b: s.b13 })), xtime(Byte { b: s.b14 })), s.b14), s.b15), 255)
      else if s.which == 14 then band(bxor(bxor(bxor(bxor(s.b12, s.b13), xtime(Byte { b: s.b14 })), xtime(Byte { b: s.b15 })), s.b15), 255)
      else band(bxor(bxor(bxor(bxor(xtime(Byte { b: s.b12 }), s.b12), s.b13), s.b14), xtime(Byte { b: s.b15 })), 255)
  proofs:
    purity:
      reads : [s.b0, s.b1, s.b2, s.b3, s.b4, s.b5, s.b6, s.b7, s.b8, s.b9, s.b10, s.b11, s.b12, s.b13, s.b14, s.b15, s.which]
      calls : [xtime]
    termination:
      bound : 800


rule add_round_key
  @intention: "AddRoundKey — XOR state byte b[which] with key byte k[which]"
  @source: aes_transforms.intent:7
  input:
    s : BlockAndKey
  output:
    out : number
  logic:
    out = if s.which == 0 then band(bxor(s.b0, s.k0), 255)
      else if s.which == 1 then band(bxor(s.b1, s.k1), 255)
      else if s.which == 2 then band(bxor(s.b2, s.k2), 255)
      else if s.which == 3 then band(bxor(s.b3, s.k3), 255)
      else if s.which == 4 then band(bxor(s.b4, s.k4), 255)
      else if s.which == 5 then band(bxor(s.b5, s.k5), 255)
      else if s.which == 6 then band(bxor(s.b6, s.k6), 255)
      else if s.which == 7 then band(bxor(s.b7, s.k7), 255)
      else if s.which == 8 then band(bxor(s.b8, s.k8), 255)
      else if s.which == 9 then band(bxor(s.b9, s.k9), 255)
      else if s.which == 10 then band(bxor(s.b10, s.k10), 255)
      else if s.which == 11 then band(bxor(s.b11, s.k11), 255)
      else if s.which == 12 then band(bxor(s.b12, s.k12), 255)
      else if s.which == 13 then band(bxor(s.b13, s.k13), 255)
      else if s.which == 14 then band(bxor(s.b14, s.k14), 255)
      else band(bxor(s.b15, s.k15), 255)
  proofs:
    purity:
      reads : [s.b0, s.b1, s.b2, s.b3, s.b4, s.b5, s.b6, s.b7, s.b8, s.b9, s.b10, s.b11, s.b12, s.b13, s.b14, s.b15, s.k0, s.k1, s.k2, s.k3, s.k4, s.k5, s.k6, s.k7, s.k8, s.k9, s.k10, s.k11, s.k12, s.k13, s.k14, s.k15, s.which]
      calls : []
    termination:
      bound : 200

