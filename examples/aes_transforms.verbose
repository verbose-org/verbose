@verbose 0.1.0

concept Byte
  @intention: "single byte 0..255"
  @source: aes_transforms.intent:1
  fields:
    b : number [0, 255]

concept Block
  @intention: "16-byte AES state + which output byte to return"
  @source: aes_transforms.intent:1
  fields:
    b0 : number [0, 255]
    b1 : number [0, 255]
    b2 : number [0, 255]
    b3 : number [0, 255]
    b4 : number [0, 255]
    b5 : number [0, 255]
    b6 : number [0, 255]
    b7 : number [0, 255]
    b8 : number [0, 255]
    b9 : number [0, 255]
    b10 : number [0, 255]
    b11 : number [0, 255]
    b12 : number [0, 255]
    b13 : number [0, 255]
    b14 : number [0, 255]
    b15 : number [0, 255]
    which : number [0, 15]

concept BlockAndKey
  @intention: "16-byte state + 16-byte round key + which output byte"
  @source: aes_transforms.intent:1
  fields:
    b0 : number [0, 255]
    b1 : number [0, 255]
    b2 : number [0, 255]
    b3 : number [0, 255]
