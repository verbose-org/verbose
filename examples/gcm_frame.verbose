@verbose 0.1.0

-- TLS 1.3 AEAD FRAMING, IN VERBOSE.
--
-- Every fixed-width step of the TLS 1.3 record-protection wrapper around
-- AES-128-GCM that the host (tools/tls_gen/vcrypto.py) used to compute in
-- Python -- because until the aggregate-return arc a rule could hand back
-- only ONE number per process, and a 12-byte nonce or a 16-byte tag is not
-- one number. Each rule below returns its whole answer as one record, so
-- each is one spawn of a verified binary.
--
-- What is here (SP 800-38D / RFC 8446 section references in each rule):
--   gcm_nonce    per-record nonce    = IV XOR [seq]64, seq right-aligned
--   gcm_j0       pre-counter block   = nonce || 0^31 || 1
--   gcm_aad      TLS record header   = 23 || 0303 || [len(inner) + 16]16
--   gcm_lenblock GHASH length block  = [len(A)*8]64 || [len(C)*8]64
--   gcm_tag      T                   = S XOR E_K(J0)
--   gcm_tag_eq   constant-time compare of two 16-byte tags -> 0 / 1
--
-- What is NOT here, and why, so the host's remaining role is stated rather
-- than implied: E_K(J0) itself is aes_encrypt.verbose::encrypt applied to
-- gcm_j0's record (the host shuttles those 16 bytes between the two
-- binaries); the per-block CTR walk is aes_gctr.verbose::gctr, one spawn
-- per 16-byte block; zero-padding a VARIABLE-length tail to a block
-- boundary and concatenating pad(A) || pad(C) || lenblock into GHASH's hex
-- input are variable-length and stay host glue by design (§4 of
-- docs/tls-io-statemachine-design.md permits framing in the host); so does
-- appending / stripping the TLS inner content type, which is not crypto.
--
-- gcm_j0 is the one aggregate-to-aggregate hop: it BINDS gcm_nonce's record
-- (`let n = gcm_nonce(i)`, slice agg-1) and EMITS its own (slice agg-2c), so
-- the nonce derivation is written once and J0 is derived from it inside the
-- verifier's reach rather than by slicing in the host.

concept RecordNonceInput
  @intention: "the 12-byte per-direction write IV and the 64-bit record sequence number"
  @source: gcm_frame.intent:1
  fields:
    iv0 : number [0, 255]
    iv1 : number [0, 255]
    iv2 : number [0, 255]
    iv3 : number [0, 255]
    iv4 : number [0, 255]
    iv5 : number [0, 255]
    iv6 : number [0, 255]
    iv7 : number [0, 255]
    iv8 : number [0, 255]
    iv9 : number [0, 255]
    iv10 : number [0, 255]
    iv11 : number [0, 255]
    seq : number [0, 9223372036854775807]

concept Nonce
  @intention: "the 12-byte per-record GCM nonce, returned as one record"
  @source: gcm_frame.intent:2
  fields:
    b0 : number [0, 255]
    b1 : number [0, 255]
    b2 : number [0, 255]
    b3 : number [0, 255]
    b4 : number [0, 255]
    b5 : number [0, 255]
    b6 : number [0, 255]
    b7 : number [0, 255]
    b8 : number [0, 255]
    b9 : number [0, 255]
    b10 : number [0, 255]
    b11 : number [0, 255]

concept J0Block
  @intention: "the 16-byte pre-counter block J0 = nonce || 0^31 || 1, returned as one record"
  @source: gcm_frame.intent:3
  fields:
    b0 : number [0, 255]
    b1 : number [0, 255]
    b2 : number [0, 255]
    b3 : number [0, 255]
    b4 : number [0, 255]
    b5 : number [0, 255]
    b6 : number [0, 255]
    b7 : number [0, 255]
    b8 : number [0, 255]
    b9 : number [0, 255]
    b10 : number [0, 255]
    b11 : number [0, 255]
    b12 : number [0, 255]
    b13 : number [0, 255]
    b14 : number [0, 255]
    b15 : number [0, 255]

concept AadInput
  @intention: "the length in bytes of the TLSInnerPlaintext (content || type || padding)"
  @source: gcm_frame.intent:4
  fields:
    inner_len : number [0, 16624]

concept RecordHeader
  @intention: "the 5-byte TLSCiphertext header, which is the AEAD's additional data"
  @source: gcm_frame.intent:5
  fields:
    b0 : number [0, 255]
    b1 : number [0, 255]
    b2 : number [0, 255]
    b3 : number [0, 255]
    b4 : number [0, 255]

concept LenInput
  @intention: "the byte lengths of the additional data and of the ciphertext"
  @source: gcm_frame.intent:6
  fields:
    aad_len : number [0, 68719476704]
    ct_len : number [0, 68719476704]

concept LenBlock
  @intention: "the 16-byte GHASH length block [len(A)]64 || [len(C)]64 in bits, returned as one record"
  @source: gcm_frame.intent:7
  fields:
    b0 : number [0, 255]
    b1 : number [0, 255]
    b2 : number [0, 255]
    b3 : number [0, 255]
    b4 : number [0, 255]
    b5 : number [0, 255]
