    r15 : number [0, 255]

rule gcm_nonce
  @intention: "RFC 8446 5.3: per-record nonce = write IV XOR the 64-bit big-endian sequence number, left-padded with zeros to 12 bytes"
  @source: gcm_frame.intent:11
  input:
    i : RecordNonceInput
  output:
    n : Nonce
  logic:
    n = Nonce {
      b0 : i.iv0,
      b1 : i.iv1,
      b2 : i.iv2,
      b3 : i.iv3,
      b4 : bxor(i.iv4, band(shr(i.seq, 56), 255)),
      b5 : bxor(i.iv5, band(shr(i.seq, 48), 255)),
      b6 : bxor(i.iv6, band(shr(i.seq, 40), 255)),
      b7 : bxor(i.iv7, band(shr(i.seq, 32), 255)),
      b8 : bxor(i.iv8, band(shr(i.seq, 24), 255)),
      b9 : bxor(i.iv9, band(shr(i.seq, 16), 255)),
      b10 : bxor(i.iv10, band(shr(i.seq, 8), 255)),
      b11 : bxor(i.iv11, band(i.seq, 255))
    }
  proofs:
    purity:
      reads : [i.iv0, i.iv1, i.iv2, i.iv3, i.iv4, i.iv5, i.iv6, i.iv7, i.iv8, i.iv9, i.iv10, i.iv11, i.seq]
      calls : []
    termination:
      bound : 24

rule gcm_j0
  @intention: "SP 800-38D 7.1 step 2 (96-bit IV): J0 = nonce || 0^31 || 1, with the nonce bound from gcm_nonce's record"
  @source: gcm_frame.intent:12
  input:
    i : RecordNonceInput
  output:
    j : J0Block
  logic:
    let n = gcm_nonce(i)
    j = J0Block {
      b0 : n.b0,
      b1 : n.b1,
      b2 : n.b2,
      b3 : n.b3,
      b4 : n.b4,
      b5 : n.b5,
      b6 : n.b6,
      b7 : n.b7,
      b8 : n.b8,
      b9 : n.b9,
      b10 : n.b10,
      b11 : n.b11,
      b12 : 0,
      b13 : 0,
      b14 : 0,
      b15 : 1
    }
  proofs:
    purity:
      reads : [i]
      calls : [gcm_nonce]
    termination:
      bound : 1

rule gcm_aad
  @intention: "RFC 8446 5.2: additional_data = opaque_type(23) || legacy_record_version(0x0303) || TLSCiphertext.length, where length = len(inner) + 16 (the tag)"
  @source: gcm_frame.intent:13
  input:
    a : AadInput
  output:
    h : RecordHeader
  logic:
    h = RecordHeader {
      b0 : 23,
      b1 : 3,
      b2 : 3,
      b3 : band(shr(a.inner_len + 16, 8), 255),
      b4 : band(a.inner_len + 16, 255)
    }
  proofs:
    purity:
      reads : [a.inner_len]
      calls : []
    termination:
      bound : 6

rule gcm_lenblock
  @intention: "SP 800-38D 7.1 step 5: the final GHASH block [len(A)]64 || [len(C)]64, both lengths in BITS, big-endian"
  @source: gcm_frame.intent:14
  input:
    l : LenInput
  output:
    b : LenBlock
  logic:
    b = LenBlock {
      b0 : band(shr(l.aad_len * 8, 56), 255),
      b1 : band(shr(l.aad_len * 8, 48), 255),
      b2 : band(shr(l.aad_len * 8, 40), 255),
      b3 : band(shr(l.aad_len * 8, 32), 255),
      b4 : band(shr(l.aad_len * 8, 24), 255),
      b5 : band(shr(l.aad_len * 8, 16), 255),
      b6 : band(shr(l.aad_len * 8, 8), 255),
      b7 : band(l.aad_len * 8, 255),
      b8 : band(shr(l.ct_len * 8, 56), 255),
      b9 : band(shr(l.ct_len * 8, 48), 255),
      b10 : band(shr(l.ct_len * 8, 40), 255),
      b11 : band(shr(l.ct_len * 8, 32), 255),
      b12 : band(shr(l.ct_len * 8, 24), 255),
      b13 : band(shr(l.ct_len * 8, 16), 255),
      b14 : band(shr(l.ct_len * 8, 8), 255),
      b15 : band(l.ct_len * 8, 255)
    }
  proofs:
    purity:
      reads : [l.aad_len, l.ct_len]
      calls : []
    termination:
      bound : 47

rule gcm_tag
  @intention: "SP 800-38D 7.1 step 6 with t = 128: T = GCTR_K(J0, S) = S XOR E_K(J0)"
  @source: gcm_frame.intent:15
  input:
    t : TagInput
  output:
    tag : Tag
  logic:
    tag = Tag {
      b0 : bxor(t.s0, t.e0),
      b1 : bxor(t.s1, t.e1),
      b2 : bxor(t.s2, t.e2),
      b3 : bxor(t.s3, t.e3),
      b4 : bxor(t.s4, t.e4),
      b5 : bxor(t.s5, t.e5),
      b6 : bxor(t.s6, t.e6),
      b7 : bxor(t.s7, t.e7),
      b8 : bxor(t.s8, t.e8),
      b9 : bxor(t.s9, t.e9),
      b10 : bxor(t.s10, t.e10),
      b11 : bxor(t.s11, t.e11),
      b12 : bxor(t.s12, t.e12),
      b13 : bxor(t.s13, t.e13),
      b14 : bxor(t.s14, t.e14),
      b15 : bxor(t.s15, t.e15)
    }
  proofs:
    purity:
      reads : [t.s0, t.s1, t.s2, t.s3, t.s4, t.s5, t.s6, t.s7, t.s8, t.s9, t.s10, t.s11, t.s12, t.s13, t.s14, t.s15, t.e0, t.e1, t.e2, t.e3, t.e4, t.e5, t.e6, t.e7, t.e8, t.e9, t.e10, t.e11, t.e12, t.e13, t.e14, t.e15]
      calls : []
    termination:
      bound : 17

-- Constant-time by SHAPE, not by luck: the 16 bytes are folded into ONE
-- accumulator with bxor / bor only -- each is a single ALU instruction with
-- no flag-dependent control flow -- so every byte is visited whether or not
-- an earlier one already differed, and the accumulator is zero iff every
-- byte matched. The single decision is `1 - min(d15, 1)`, and `min` lowers
-- to cmp + cmov (branch-free) rather than a conditional jump: the emitted
-- x86 between the first field load and the result contains no jcc at all
-- (checked with objdump; see the PR that added this file). What is NOT
-- constant-time is the argv transport around it -- the per-field atoi in
-- the prologue loops once per decimal digit, so "5" and "255" cost
-- different iterations -- which is a property of how the host feeds the
-- binary, not of the compare; it is stated here so nobody reads this rule
-- as a claim about the whole process.
rule gcm_tag_eq
  @intention: "constant-time equality of two 16-byte tags: 1 when every byte matches, 0 otherwise, with no data-dependent branch in the accumulation"
  @source: gcm_frame.intent:16
  input:
    p : TagPair
  output:
    eq : number
  logic:
    let d0 = bxor(p.a0, p.r0)
    let d1 = bor(d0, bxor(p.a1, p.r1))
    let d2 = bor(d1, bxor(p.a2, p.r2))
    let d3 = bor(d2, bxor(p.a3, p.r3))
    let d4 = bor(d3, bxor(p.a4, p.r4))
    let d5 = bor(d4, bxor(p.a5, p.r5))
    let d6 = bor(d5, bxor(p.a6, p.r6))
    let d7 = bor(d6, bxor(p.a7, p.r7))
    let d8 = bor(d7, bxor(p.a8, p.r8))
    let d9 = bor(d8, bxor(p.a9, p.r9))
    let d10 = bor(d9, bxor(p.a10, p.r10))
    let d11 = bor(d10, bxor(p.a11, p.r11))
    let d12 = bor(d11, bxor(p.a12, p.r12))
    let d13 = bor(d12, bxor(p.a13, p.r13))
    let d14 = bor(d13, bxor(p.a14, p.r14))
    let d15 = bor(d14, bxor(p.a15, p.r15))
    eq = 1 - min(d15, 1)
  proofs:
    purity:
      reads : [p.a0, p.a1, p.a2, p.a3, p.a4, p.a5, p.a6, p.a7, p.a8, p.a9, p.a10, p.a11, p.a12, p.a13, p.a14, p.a15, p.r0, p.r1, p.r2, p.r3, p.r4, p.r5, p.r6, p.r7, p.r8, p.r9, p.r10, p.r11, p.r12, p.r13, p.r14, p.r15]
      calls : []
    termination:
      bound : 2
