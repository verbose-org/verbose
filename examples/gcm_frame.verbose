concept TagPair
  @intention: "two 16-byte tags to compare: the one computed and the one received"
  @source: gcm_frame.intent:10
  fields:
    a0 : number [0, 255]
    a1 : number [0, 255]
    a2 : number [0, 255]
    a3 : number [0, 255]
    a4 : number [0, 255]
    a5 : number [0, 255]
    a6 : number [0, 255]
    a7 : number [0, 255]
