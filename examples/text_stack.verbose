@verbose 0.1.0

concept TextReading
  @intention: "Accept a bounded UTF-8 label and a signed reading"
  @source: text_stack.intent:1
  fields:
    title : text [..8]
    code : number

rule format_reading
  @intention: "Format a reading within explicit output and native stack limits"
  @source: text_stack.intent:2
  input:
    item : TextReading
  output:
    out : text [..30]
  logic:
    out = concat("[", item.title, "]", item.code)
  proofs:
    native_stack: 208
    purity:
      reads: [item.title, item.code]
      calls: []
    termination:
      bound: 16

rule repeat_reading
  @intention: "Keep one formatted value alive through an alias and a second call"
  @source: text_stack.intent:3
  input:
    request : TextReading
  output:
    out : text [..63]
  logic:
    let message = format_reading(request)
    let saved = message
    let message = format_reading(request)
    out = concat(saved, " | ", message)
  proofs:
    native_stack: 384
    purity:
      reads: [request]
      calls: [format_reading]
    termination:
      bound: 32
