@verbose 0.1.0

concept Byte
  @intention: "byte"
  @source: invoices.intent:1
  fields:
    b : number [0, 255]

concept CtrInput
  @intention: "AES-128 key + 12-byte IV + plaintext hex + nblocks + which output byte"
  @source: invoices.intent:1
  fields:
    k0 : number [0, 255]
    k1 : number [0, 255]
    k2 : number [0, 255]
    k3 : number [0, 255]
