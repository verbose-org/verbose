    "source": "#define _GNU_SOURCE\n#include <stdio.h>\n#include <sys/timex.h>\n#include <time.h>\n\nstatic long long ns(clockid_t id) {\n    struct timespec t;\n    if (clock_gettime(id, &t)) return -1;\n    return (long long)t.tv_sec * 1000000000LL + t.tv_nsec;\n}\nint main(void) {\n    struct timex t = {0}; /* modes=0 queries only; never changes kernel time. */\n    int state = adjtimex(&t);\n    long long raw = ns(CLOCK_MONOTONIC_RAW);\n    long long mono = ns(CLOCK_MONOTONIC);\n    long long cpu = ns(CLOCK_PROCESS_CPUTIME_ID);\n    while (ns(CLOCK_MONOTONIC_RAW) - raw < 3000000000LL) {}\n    long long raw_end = ns(CLOCK_MONOTONIC_RAW);\n    long long mono_end = ns(CLOCK_MONOTONIC);\n    long long cpu_end = ns(CLOCK_PROCESS_CPUTIME_ID);\n    printf(\"{\\\"raw_ms\\\":%.6f,\\\"monotonic_ms\\\":%.6f,\\\"process_ms\\\":%.6f,\"\n           \"\\\"adjtimex_query\\\":{\\\"state\\\":%d,\\\"status\\\":%d,\\\"tick_us\\\":%ld,\\\"freq_scaled_ppm\\\":%ld,\\\"offset\\\":%ld}}\\n\",\n           (raw_end-raw)/1e6,(mono_end-mono)/1e6,(cpu_end-cpu)/1e6,state,t.status,t.tick,t.freq,t.offset);\n    return 0;\n}\n",
