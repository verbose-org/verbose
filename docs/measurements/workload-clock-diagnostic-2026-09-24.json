  "parent_probe_source": "\"\"\"Bounded, serial clock diagnostic, independent of Verbose and its compiler.\"\"\"\nimport hashlib\nimport json\nimport os\nfrom pathlib import Path\nimport platform\nimport resource\nimport subprocess\nimport sys\nimport time\n\nCHILD = r'''\nimport json, os, resource, sys, time\nfrom pathlib import Path\nmode, duration = sys.argv[1], float(sys.argv[2])\ndef snapshot():\n    r = resource.getrusage(resource.RUSAGE_SELF)\n    return dict(monotonic_ns=time.monotonic_ns(), raw_ns=time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW),\n                process_ns=time.process_time_ns(), thread_ns=time.thread_time_ns(),\n                self_ns=round((r.ru_utime + r.ru_stime) * 1e9))\nbefore = snapshot()\nif mode == 'busy':\n    deadline = before['raw_ns'] + int(duration * 1e9)\n    while time.clock_gettime_ns(time.CLOCK_MONOTONIC_RAW) < deadline:\n        pass\nelse:\n    time.sleep(duration)\nafter = snapshot()\nprint(json.dumps(dict(milliseconds={k[:-3]: (after[k]-v)/1e6 for k,v in before.items()},\n                      task_count=len(list(Path('/proc/self/task').iterdir())), affinity=sorted(os.sched_getaffinity(0)))))\n'''\n\ndef text(path):\n    p = Path(path)\n    return p.read_text().strip() if p.exists() else None\n\nreport = dict(schema_version=1, purpose='independent single-thread clock/accounting diagnostic',\n              started_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n              host_note='User confirms no significant external load. No other builds, tests or benchmarks launched by this session.',\n              platform=platform.platform(), python=sys.version, clocksource=text('/sys/devices/system/clocksource/clocksource0/current_clocksource'),\n              available_clocksources=text('/sys/devices/system/clocksource/clocksource0/available_clocksource'),\n              source_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest(), child_code=CHILD,\n              clock_info={name:vars(time.get_clock_info(name)) for name in ['monotonic','perf_counter','process_time','thread_time']},\n              samples=[])\noutput = Path(sys.argv[1])\nif output.exists():\n    raise SystemExit('output already exists')\nfor repeat in range(3):\n    for cpus in ([2], [2,4,6,8]):\n        os.sched_setaffinity(0, cpus)\n        for mode, duration in [('busy', .3), ('busy', 1), ('busy', 3), ('sleep', .3)]:\n            before = resource.getrusage(resource.RUSAGE_CHILDREN)\n            start = time.monotonic_ns()\n            out = subprocess.run([sys.executable, '-I', '-S', '-c', CHILD, mode, str(duration)],\n                                 capture_output=True, check=True, timeout=15)\n            end = time.monotonic_ns()\n            after = resource.getrusage(resource.RUSAGE_CHILDREN)\n            if out.stderr:\n                raise RuntimeError(out.stderr)\n            r = dict(repeat=repeat, cpus=cpus, mode=mode, requested_seconds=duration,\n                     parent_wall_ms=(end-start)/1e6,\n                     parent_child_cpu_ms=(after.ru_utime-before.ru_utime+after.ru_stime-before.ru_stime)*1000,\n                     child=json.loads(out.stdout))\n            m = r['child']['milliseconds']\n            r['inner_flag'] = m['process'] > m['monotonic'] + max(20, .05*m['monotonic'])\n            r['outer_flag'] = r['parent_child_cpu_ms'] > r['parent_wall_ms'] + max(20, .05*r['parent_wall_ms'])\n            report['samples'].append(r)\n            output.write_text(json.dumps(report, indent=2) + '\\n')\nreport['finished_utc'] = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())\noutput.write_text(json.dumps(report, indent=2) + '\\n')\nprint(json.dumps(dict(samples=len(report['samples']), flagged=sum(r['inner_flag'] or r['outer_flag'] for r in report['samples']))))\n",
